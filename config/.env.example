# AI API Key - 二选一
# DeepSeek API Key（推荐）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kimi (月之暗面) API Key
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek / Kimi API 基础URL（可选，用于代理）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# KIMI_BASE_URL=https://api.moonshot.cn

# HimmPat 登录凭证 - 仅在 login_mode = "auto" 时需要
HIMMPAT_USERNAME=your_phone_or_email
HIMMPAT_PASSWORD=your_password
